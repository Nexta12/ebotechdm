# Hostinger SMTP Configuration
# Replace these with your actual Hostinger email address and password

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@yourdomain.com
SMTP_PASS=your_hostinger_email_password

# The display name and email address that sent messages will appear from
SMTP_FROM_NAME="Ebotech Digital Skills Project"
SMTP_FROM_EMAIL=info@yourdomain.com

# Where you want to receive new applicant notifications
ADMIN_NOTIFICATION_EMAIL=info@yourdomain.com
